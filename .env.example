# KAI System — Environment Config
# Copy this to .env and fill in values
# Never commit .env to git

# Service ports (change if conflicts)
WORKER_API_PORT=8001
COUNCIL_API_PORT=8002

# Model config
KAI_FAST_MODEL=claude-haiku-4-5-20251001
KAI_SMART_MODEL=claude-sonnet-4-5
COUNCIL_MODEL=claude-sonnet-4-5

# Vault path inside containers (do not change)
VAULT_PATH=/vault

# Log level
LOG_LEVEL=INFO
