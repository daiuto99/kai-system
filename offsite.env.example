# Offsite backup transport config — S1-B3 (audit #01, Track 3).
# Copy to offsite.env and set OFFSITE_ENABLED=1 to ENABLE the nightly offsite mirror.
# Enabling is a designated GATE (Leo authorizes): first install the worker's
# ~/.ssh/id_ed25519.pub into the target host's authorized_keys, then flip the flag.
# offsite.env is gitignored (*.env); this .example is the tracked template.
OFFSITE_ENABLED=0
OFFSITE_USER=leodaiuto
# 71-kai-mini (Intel inference node) on the tailnet. Must be awake/SSH-reachable.
OFFSITE_HOST=100.106.160.41
# macOS path today; becomes /home/leodaiuto/... if the mini is reimaged to Linux.
OFFSITE_DIR=/Users/leodaiuto/kai-offsite-backups
OFFSITE_SSH_KEY=/home/leo/.ssh/id_ed25519
